# Copier ce fichier en .env et adapter les valeurs. Ne jamais commiter .env.

# --- Base de données ---
POSTGRES_USER=griotoon
POSTGRES_PASSWORD=griotoon
POSTGRES_DB=griotoon
DATABASE_URL=postgresql+psycopg://griotoon:griotoon@localhost:5432/griotoon

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Stockage (MinIO en dev, compatible S3) ---
MINIO_ROOT_USER=griotoon
MINIO_ROOT_PASSWORD=griotoon-secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=griotoon
S3_ACCESS_KEY=griotoon
S3_SECRET_KEY=griotoon-secret

# --- API backend (utilisée par le front) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- IA (phases 2 et suivantes) ---
ANTHROPIC_API_KEY=
IMAGE_PROVIDER=replicate        # replicate | fal
REPLICATE_API_TOKEN=
FAL_KEY=
MAX_GENERATIONS_PER_DAY=50
